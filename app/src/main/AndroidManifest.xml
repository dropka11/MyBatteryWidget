<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.senin.paketin">
    
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="My Battery Widget"
        android:theme="@android:style/Theme.NoTitleBar">
        
        <receiver android:name=".BatteryWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        
        <service android:name=".BatteryService" 
            android:exported="false" 
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ ve One UI 8.0'ın çökmeyi önlemek için zorunlu kıldığı etiket -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="battery_level_tracking" />
        </service>
    </application>
</manifest>
